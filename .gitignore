# Secrets
.env
.env.*
!.env.example

# Run scratch output (run.json / index.jsonl stay tracked for audit)
runs/*/raw.jsonl
runs/*/stderr.log
runs/*/validation.stderr.log
runs/*/repo/

# Python
__pycache__/
*.pyc

# painmine spike: raw collected material and cross-run state stay out of Git
# (structured artefacts and reports under painmine/poc/ are kept)
painmine/state/
painmine/poc/**/raw-items.jsonl

# OS
.DS_Store
